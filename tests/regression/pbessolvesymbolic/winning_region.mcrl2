% A model in which the property winning_region.mcf holds in some reachable states but not in all of
% them, so that the winning region of the winning player is a strict subset of the parity game.
% From P the property holds (Q is reachable, and c is enabled there), and it holds in Q, but it
% fails in R, which can only ever do e. The vertex for P therefore belongs to the winning player and
% has an edge into the losing region.

act a, b, c, d, e;

proc P = a . P + b . Q + d . R;
     Q = c . Q;
     R = e . R;

init P;
